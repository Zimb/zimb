{
  "name": "zimb-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Zimb.app — plateforme de bounty debugging (Vibe Coders ↔ Seniors)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,dart}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,dart}\"",
    "init:airtable": "tsx packages/worker/scripts/init-airtable.ts",
    "smoke:test": "tsx packages/worker/scripts/smoke-test.ts",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.7.0"
}
