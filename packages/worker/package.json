{
  "name": "@zimb/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker backend at api.zimb.app",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "tail": "wrangler tail",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "init:airtable": "tsx scripts/init-airtable.ts",
    "smoke:test": "tsx scripts/smoke-test.ts",
    "clean": "rm -rf dist .wrangler .dev"
  },
  "dependencies": {
    "@octokit/auth-app": "^7.1.4",
    "@octokit/rest": "^21.0.0",
    "@octokit/webhooks": "^13.5.0",
    "airtable": "^0.12.2",
    "hono": "^4.5.7",
    "jose": "^5.9.3",
    "resend": "^4.0.0",
    "stripe": "^17.0.0",
    "zod": "^3.23.8"
  },

  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.1",
    "wrangler": "^3.78.4"
  }
}
